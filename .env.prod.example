# Production environment variables for La Biblioteca.
#
# HOW TO USE
# ----------
# 1. Copy this file:       cp .env.prod.example .env.prod
# 2. Fill in every value   (replace ALL angle-bracket placeholders)
# 3. NEVER commit .env.prod to version control — it is listed in .gitignore
# 4. Load it before starting the stack:
#
#      set -a && source .env.prod && set +a
#      docker compose -f compose.yaml -f compose.prod.yaml up -d
#
# Alternatively, inject these variables through your cloud provider's secrets
# manager (AWS SSM Parameter Store, GCP Secret Manager, HashiCorp Vault, etc.)
# and export them into the environment that runs docker compose.
#
# All variables without defaults in compose.prod.yaml are marked REQUIRED below.
# The compose file uses the :? syntax, so docker compose will refuse to start
# if a REQUIRED variable is missing or empty.

# ── Symfony ────────────────────────────────────────────────────────────────────

# REQUIRED — 32-character random string used to sign sessions and CSRF tokens.
# Generate with:  php -r "echo bin2hex(random_bytes(16)) . PHP_EOL;"
# Or:             openssl rand -hex 16
APP_SECRET=<generate-a-32-char-random-hex-string>

# Fixed to prod — do not change.
APP_ENV=prod

# ── Database ───────────────────────────────────────────────────────────────────

# REQUIRED — Password for the 'biblioteca_user' application account.
# Use a strong, randomly-generated value (min 24 characters recommended).
MYSQL_PASSWORD=<strong-unique-password>

# REQUIRED — Password for the MySQL 'root' account.
# Store separately from MYSQL_PASSWORD; root access should never be used by
# the application itself.
MYSQL_ROOT_PASSWORD=<strong-unique-root-password>

# ── JWT Authentication ─────────────────────────────────────────────────────────

# REQUIRED — Passphrase used to encrypt the JWT private key.
# This MUST match the passphrase you used when generating the key pair with:
#   openssl genrsa -aes256 -out oracles-api/config/jwt/private.pem 4096
#   openssl rsa -pubout -in oracles-api/config/jwt/private.pem -out oracles-api/config/jwt/public.pem
# The private key (private.pem) must be present inside the backend container.
# If regenerating keys, all existing refresh tokens become invalid.
JWT_PASSPHRASE=<strong-random-passphrase>

# ── CORS ───────────────────────────────────────────────────────────────────────

# REQUIRED — Exact origin of your frontend application (no trailing slash).
# Must match the Origin header sent by browsers, including scheme and port.
# Examples:
#   https://biblioteca.yourdomain.com
#   https://app.yourdomain.com
CORS_ALLOW_ORIGIN=https://your-domain.com

# ── Frontend build ─────────────────────────────────────────────────────────────

# BUILD-TIME — Full URL of the backend API (no trailing slash).
# This value is baked into the frontend JS bundle at build time by Vite.
# Changing it requires a full frontend image rebuild.
# Examples:
#   https://api.yourdomain.com
#   https://yourdomain.com (if API is served from the same domain)
#
# After changing this, also update the Content-Security-Policy connect-src in
# thelibrary/nginx.conf to allow the new origin.
VITE_API_BASE_URL=https://api.your-domain.com
