# Root .env — Docker Compose variable overrides (dev defaults)
# This file is committed. Do NOT put production secrets here.
# Override values locally by creating a .env.local file (git-ignored).

# MySQL
# IMPORTANT: Change these before any shared or production deployment
MYSQL_ROOT_PASSWORD=root_secret_dev
MYSQL_PASSWORD=biblioteca_pass_dev

# PHP/XDebug — must match the server name configured in PhpStorm
# Settings > PHP > Servers > Name: biblioteca
PHP_IDE_CONFIG=serverName=biblioteca

# Symfony app secret — override in .env.local with a real random value
# Generate one: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change_me_before_production

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me
###< lexik/jwt-authentication-bundle ###
